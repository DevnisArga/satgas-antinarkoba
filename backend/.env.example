# Backend Environment Configuration
# Salin file ini menjadi .env dan sesuaikan dengan hosting / VPS Anda

# Port Server (Otomatis disediakan oleh Railway / Render / Heroku)
PORT=5000
NODE_ENV=production

# Database MySQL Manual (Gunakan ini jika di cPanel / VPS / Local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=satgas_antinarkoba
DB_SSL=false

# ATAU Database MySQL Cloud (Railway, Render, Clever Cloud otomatis menyediakan ini):
# DATABASE_URL=mysql://user:pass@host:port/database

# Keamanan JWT (Ganti dengan string acak yang kuat)
JWT_SECRET=ganti-dengan-string-rahasia-panjang-dan-acak-di-production-min-32-karakter
JWT_EXPIRES_IN=8h

# Kunci Enkripsi Data Pelapor (AES-256-GCM) - Ganti dengan string acak
ENCRYPTION_KEY=ganti-dengan-kunci-enkripsi-rahasia-32-karakter

# Batas Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# URL Frontend (Untuk konfigurasi CORS). Bisa dipisah koma jika lebih dari satu.
FRONTEND_URL=http://localhost:5173,https://satgas.polinela.ac.id
