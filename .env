# Server
PORT=5000
NODE_ENV=development

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Devnisarga29
DB_NAME=satgas_antinarkoba

# JWT
JWT_SECRET=satgas-antinarkoba-secret-key-change-in-production
JWT_EXPIRES_IN=8h

# Encryption (AES-256-GCM untuk data identitas pelapor)
ENCRYPTION_KEY=32-byte-hex-key-change-in-production-env

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=26214400

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
